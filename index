/* router por pestañas */
function route(){
  const id=(location.hash||'#inicio').slice(1);
  const pg=$('#p-'+id)?id:'inicio';
  $$('.page').forEach(p=>p.classList.toggle('on',p.id==='p-'+pg));
  $$('#idx a').forEach(a=>{const on=a.getAttribute('href')==='#'+pg;if(on){a.setAttribute('aria-current','page');a.scrollIntoView({inline:'center',block:'nearest'})}else a.removeAttribute('aria-current')});
  window.scrollTo(0,0);
}
addEventListener('hashchange',route);route();

/* carrito */
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),2200)}
const WA='51941090865';
function waCart(){
  const ids=Object.keys(cart);
  let t='Hola Qollana Studio, quiero reservar:\n';
  let sub=0;
  ids.forEach(k=>{const p=get(k);t+='• '+cart[k]+' × '+p.n+(p.price?' ('+money(p.price)+')':' (precio por confirmar)')+'\n';sub+=(p.price||0)*cart[k]});
  if(sub)t+='\nSubtotal con precio publicado: '+money(sub)+'\nAdelanto del 50%: '+money(sub/2);
  return 'https://wa.me/'+WA+'?text='+encodeURIComponent(t);
}
function drawCart(){
  const ids=Object.keys(cart);
  $('#cartN').textContent=ids.reduce((a,k)=>a+cart[k],0);
  $('#items').innerHTML=ids.length?ids.map(k=>{const p=get(k);return `<div class="li"><img src="${imgOf(p)}" alt=""><div><b>${p.n}</b><div class="qty"><button data-q="-1" data-id="${k}" aria-label="Quitar uno">–</button><span>${cart[k]}</span><button data-q="1" data-id="${k}" aria-label="Agregar uno">+</button></div></div><div style="text-align:right;font-weight:800">${p.price?money(p.price*cart[k]):'<span class="note">Por confirmar</span>'}</div></div>`}).join(''):'<p class="note">Tu reserva está vacía. Agrega productos desde el catálogo.</p>';
  const sub=ids.reduce((a,k)=>a+(get(k).price||0)*cart[k],0);
  const tbd=ids.some(k=>!get(k).price);
  $('#cartFoot').innerHTML=ids.length?`<div class="tot"><span>Subtotal con precio publicado</span><span>${money(sub)}</span></div>
  <div class="tot" style="color:var(--red)"><span>Adelanto del 50%</span><span>${money(sub/2)}</span></div>
  <div class="tot"><span>Saldo al recibir</span><span>${money(sub/2)}</span></div>
  ${tbd?'<p class="note">Hay productos con precio por confirmar. No están incluidos en estos montos.</p>':''}
  <a class="btn wab" id="reserve" target="_blank" rel="noopener" href="${waCart()}">Enviar pedido por WhatsApp</a>
  <p class="note">Se abre WhatsApp con tu pedido escrito. Aún no se cobra nada: el adelanto del 50% se coordina por el chat.</p>`:'';
}
function add(id){cart[id]=(cart[id]||0)+1;drawCart();toast('Agregado a tu reserva')}
function openCart(o){$('#drawer').classList.toggle('on',o);$('#scrim').classList.toggle('on',o);$('#drawer').setAttribute('aria-hidden',!o)}
$('#openCart').onclick=()=>openCart(true);$('#closeCart').onclick=$('#scrim').onclick=()=>openCart(false);
$('#items').addEventListener('click',e=>{const b=e.target.closest('[data-q]');if(!b)return;const k=b.dataset.id;cart[k]+=+b.dataset.q;if(cart[k]<=0)delete cart[k];drawCart()});

document.addEventListener('click',e=>{
  const a=e.target.closest('[data-add]');if(a){add(a.dataset.add);return}
  const o=e.target.closest('[data-open]');if(o){openModal(o.dataset.open)}
});
function openModal(id){
  const p=get(id);
  $('#modalBox').innerHTML=`<button class="x" id="mx" aria-label="Cerrar">×</button><img src="${imgOf(p)}" alt="${p.n}"><div class="tx"><span class="eyebrow">Producto N.º ${p.id}</span><h3 style="font-size:1.5rem">${p.n}</h3><p style="color:var(--muted)">${p.d}</p><ul style="margin:0;padding-left:1.1rem;color:var(--muted)">${p.f.map(x=>`<li>${x}</li>`).join('')}</ul>${p.price?`<span class="price">${money(p.price)}</span>`:`<span class="price tbd">Precio por confirmar</span>`}<div><button class="btn red" data-add="${p.id}">Reservar</button></div></div>`;
  $('#modal').classList.add('on');$('#mx').focus();
}
$('#modal').addEventListener('click',e=>{if(e.target.id==='modal'||e.target.id==='mx')$('#modal').classList.remove('on')});
addEventListener('keydown',e=>{if(e.key==='Escape'){$('#modal').classList.remove('on');openCart(false)}});
drawCart();

