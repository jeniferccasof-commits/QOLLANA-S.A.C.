const DIAS=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'],BLQ=['Mañana','Tarde','Noche'];
let h='<div class="h"></div>'+DIAS.map(d=>`<div class="h">${d}</div>`).join('');
BLQ.forEach((b,bi)=>{h+=`<div class="r">${b}</div>`+DIAS.map((d,di)=>`<div><textarea data-k="qs-wk-${bi}-${di}" aria-label="${d} ${b}"></textarea></div>`).join('')});
