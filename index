/* hábitos */
const HAB0=['Repasar mis apuntes el mismo día','Estudiar en bloques de 25 minutos','Leer 20 minutos','Resolver ejercicios de práctica','Dormir 7 horas o más','Revisar mi planificador'];
let habState=JSON.parse(ls.get('qs-hab',JSON.stringify({n:HAB0,c:HAB0.map(()=>[0,0,0,0,0,0,0])})));
function drawHab(){
  let x='<div class="hab"><span class="dh" style="text-align:left">Hábito</span>'+DIAS.map(d=>`<span class="dh">${d}</span>`).join('')+'<span class="dh">Semana</span></div>';
  habState.n.forEach((n,i)=>{const done=habState.c[i].reduce((a,b)=>a+b,0);
    x+=`<div class="hab" style="margin-top:.5rem"><input type="text" value="${n.replace(/"/g,'&quot;')}" data-hn="${i}" aria-label="Nombre del hábito ${i+1}">`+habState.c[i].map((v,d)=>`<input type="checkbox" data-hc="${i}-${d}" ${v?'checked':''} aria-label="${n}, ${DIAS[d]}">`).join('')+`<span class="pc">${done}/7</span></div>`});
  $('#hab').innerHTML=x;
  const tot=habState.c.flat().reduce((a,b)=>a+b,0),max=habState.c.length*7;
  $('#habBar').style.width=Math.round(tot/max*100)+'%';
  $('#habTxt').textContent=tot+' de '+max+' marcas cumplidas esta semana ('+Math.round(tot/max*100)+'%).';
  ls.set('qs-hab',JSON.stringify(habState));
}
$('#hab').addEventListener('change',e=>{const c=e.target.dataset.hc;if(c){const[i,d]=c.split('-').map(Number);habState.c[i][d]=e.target.checked?1:0;drawHab()}});
$('#hab').addEventListener('input',e=>{const i=e.target.dataset.hn;if(i!==undefined){habState.n[i]=e.target.value;ls.set('qs-hab',JSON.stringify(habState))}});
drawHab();
